[[5,315,"नवम अध्याय — दर्शनमोहान्तराययोरदर्शनालाभौ"],[5,316,"नवम अध्याय — चारित्रमोहे नाग्न्यारतिस्त्रीनिषद्याक्रोशयाचनासत्कारपुरस्काराः"],[5,317,"नवम अध्याय — वेदनीये शेषाः"],[5,318,"नवम अध्याय — एकादयो भाज्या युगपदेकस्मिन्नैकोनविंशतेः"],[5,319,"नवम अध्याय — सामायिकच्छेदोपस्थापनापरिहारविशुद्धिसूक्ष्मसाम्पराययथाख्यातमिति चारित्रम्"],[5,320,"नवम अध्याय — अनशनावमौदर्यवृत्तिपरिसंख्यानरसपरित्यागविविक्तशय्यासनकायक्लेशा बाह्यं तपः"],[5,321,"नवम अध्याय — प्रायश्चित्तविनयवैयावृत्त्यस्वाध्यायव्युत्सर्गध्यानान्युत्तरम्"],[5,322,"नवम अध्याय — नवचतुर्दशपञ्चद्विभेदा यथाक्रमं प्राग्ध्यानात्"],[5,323,"नवम अध्याय — आलोचनप्रतिक्रमणतदुभयविवेकव्युत्सर्गतपश्छेदपरिहारोपस्थापनाः"],[5,324,"नवम अध्याय — ज्ञानदर्शनचारित्रोपचाराः"],[5,325,"नवम अध्याय — आचार्योपाध्यायतपस्विशैक्षग्लानगणकुलसंघसाधुमनोज्ञानाम्"],[5,326,"नवम अध्याय — वाचनापृच्छनानुप्रेक्षाम्नायधर्मोपदेशाः"],[5,327,"नवम अध्याय — बाह्याभ्यन्तरोपध्योः"],[5,328,"नवम अध्याय — उत्तमसंहननस्यैकाग्रचिन्तानिरोधो ध्यानमान्तर्मुहूर्तात्"],[5,329,"नवम अध्याय — आर्तरौद्रधर्म्यशुक्लानि"],[5,330,"नवम अध्याय — परे मोक्षहेतू"],[5,331,"नवम अध्याय — आर्तममनोज्ञस्य सम्प्रयोगे तद्विप्रयोगाय स्मृतिसमन्वाहारः"],[5,332,"नवम अध्याय — विपरीतं मनोज्ञस्य"],[5,333,"नवम अध्याय — वेदनायाश्च"],[5,334,"नवम अध्याय — निदानं च"],[5,335,"नवम अध्याय — तदविरतदेशविरतप्रमत्तसंयतानाम्"],[5,336,"नवम अध्याय — हिंसानृतस्तेयविषयसंरक्षणेभ्यो रौद्रमविरतदेशविरतयोः"],[5,337,"नवम अध्याय — आज्ञापायविपाकसंस्थानविचयाय धर्म्यम्"],[5,338,"नवम अध्याय — शुक्ले चाद्ये पूर्वविदः"],[5,339,"नवम अध्याय — परे केवलिनः"]]