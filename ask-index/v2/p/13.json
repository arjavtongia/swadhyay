[[5,240,"सप्तम अध्याय — वाङ्मनोगुप्तीर्यादाननिक्षेपणसमित्यालोकितपानभोजनानि पञ्च"],[5,241,"सप्तम अध्याय — क्रोधलोभभीरुत्वहास्यप्रत्याख्यानान्यनुवीचिभाषणं च पञ्च"],[5,242,"सप्तम अध्याय — शून्यागारविमोचितावासपरोपरोधाकरणभैक्ष्यशुद्धिसधर्माविसंवादाः पञ्च"],[5,243,"सप्तम अध्याय — स्त्रीरागकथाश्रवणतन्मनोहराङ्गनिरीक्षणपूर्वरतानुस्मरणवृष्येष्टरसस्वशरीरसंस्कारत्यागाः पञ्च"],[5,244,"सप्तम अध्याय — मनोज्ञामनोज्ञेन्द्रियविषयरागद्वेषवर्जनानि पञ्च"],[5,245,"सप्तम अध्याय — हिंसादिष्विहामुत्रापायावद्यदर्शनम्"],[5,246,"सप्तम अध्याय — दुःखमेव वा"],[5,247,"सप्तम अध्याय — मैत्रीप्रमोदकारुण्यमाध्यस्थ्यानि च सत्त्वगुणाधिकक्लिश्यमानाविनयेषु"],[5,248,"सप्तम अध्याय — जगत्कायस्वभावौ वा संवेगवैराग्यार्थम्"],[5,249,"सप्तम अध्याय — प्रमत्तयोगात्प्राणव्यपरोपणं हिंसा"],[5,250,"सप्तम अध्याय — असदभिधानमनृतम्"],[5,251,"सप्तम अध्याय — अदत्तादानं स्तेयम्"],[5,252,"सप्तम अध्याय — मैथुनमब्रह्म"],[5,253,"सप्तम अध्याय — मूर्च्छा परिग्रहः"],[5,254,"सप्तम अध्याय — निःशल्यो व्रती"],[5,255,"सप्तम अध्याय — अगार्यनगारश्च"],[5,256,"सप्तम अध्याय — अणुव्रतोऽगारी"],[5,257,"सप्तम अध्याय — दिग्देशानर्थदण्डविरतिसामायिकप्रोषधोपवासोपभोगपरिभोगपरिमाणातिथिसंविभागव्रतसम्पन्नश्च"],[5,258,"सप्तम अध्याय — मारणान्तिकीं सल्लेखनां जोषिता"],[5,259,"सप्तम अध्याय — शङ्काकाङ्क्षाविचिकित्सान्यदृष्टिप्रशंसासंस्तवाः सम्यग्दृष्टेरतीचाराः"],[5,260,"सप्तम अध्याय — व्रतशीलेषु पञ्च पञ्च यथाक्रमम्"],[5,261,"सप्तम अध्याय — बन्धवधच्छेदातिभारारोपणान्नपाननिरोधाः"],[5,262,"सप्तम अध्याय — मिथ्योपदेशरहोभ्याख्यानकूटलेखक्रियान्यासापहारसाकारमन्त्रभेदाः"],[5,263,"सप्तम अध्याय — स्तेनप्रयोगतदाहृतादानविरुद्धराज्यातिक्रमहीनाधिकमानोन्मानप्रतिरूपकव्यवहाराः"],[5,264,"सप्तम अध्याय — परविवाहकरणेत्वरिकापरिगृहीतापरिगृहीतागमनानङ्गक्रीडाकामतीव्राभिनिवेशाः"]]